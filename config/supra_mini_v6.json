{
    "run": {
        "mode"   : "train",
        "seed"   : 0,
        "device" : "auto",
        "log_dir": "log"
    },
    "data": {
        "name"                 : "pretrain",
        "sources"              : [
            {"root": "data/fineweb_edu", "repeat": 1.0},
            {"root": "data/cosmopedia" , "repeat": 1.0}
        ],
        "batch_size"           : 32,
        "num_workers"          : 8,
        "max_length"           : 1024,
        "tokenizer_dir"        : "model/weight/hotaru_edu",
        "teacher_tokenizer_dir": null
    },
    "model": {
        "name"              : "supra_mini_v6",
        "checkpoint"        : null,
        "teacher_name"      : "supra_mini_v6",
        "teacher_checkpoint": null
    },
    "train": {
        "method"            : "normal",
        "steps"             : 19054,
        "eval_interval"     : 1000,
        "accumulation_steps": 8,
        "max_grad_norm"     : 1.0,
        "cuda_graph"        : true,
        "log_interval"      : 20,
        "resume"            : null,
        "loss": {
            "name"    : "cross_entropy_z_loss",
            "z_weight": 0.0001
        },
        "optimizer": {
            "name"                      : "normuon",
            "learning_rate"             : 0.0006,
            "weight_decay"              : 0.01,
            "betas"                     : [0.9, 0.95],
            "embedding_lr_scale"        : 0.3,
            "muon_learning_rate"        : 0.02,
            "muon_momentum"             : 0.95,
            "muon_momentum_start"       : 0.85,
            "muon_momentum_warmup_steps": 300,
            "normuon_beta2"             : 0.95
        },
        "scheduler": {
            "name"                 : "wsd",
            "warmup_steps"         : 500,
            "decay_fraction"       : 0.2,
            "minimum_learning_rate": 0.0
        },
        "distillation": {
            "temperature": 2.0,
            "alpha"      : 0.5
        }
    },
    "validator": {
        "chat": {
            "style"         : "text",
            "max_new_tokens": 128,
            "temperature"   : 0.8,
            "top_k"         : 40
        },
        "benchmark": {
            "tasks"     : ["blimp", "arc_easy_tinyml", "wikitext2", "hellaswag", "arc_easy", "arc_challenge", "piqa", "arithmark3"],
            "batch_size": 64,
            "data_dir"  : "data/benchmark"
        }
    }
}
